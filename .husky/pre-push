#!/usr/bin/env bash

# Enforce branch naming convention before publishing/pushing to remote
# Allowed formats:
#   - feature/<ticket-number>-<description>
#   - bugfix/<ticket-number>-<description>
#   - hotfix/<ticket-number>-<description>
#   - docs/<ticket-number>-<description>
#   - refactor/<ticket-number>-<description>
#   - main, dev

z40="0000000000000000000000000000000000000000"
PATTERN="^(main|dev|(feature|bugfix|hotfix|docs|refactor)\/([A-Za-z0-9]+-[0-9]+|[0-9]+)-[a-z0-9-]+)$"

while read -r local_ref local_oid remote_ref remote_oid; do
  # Allow remote branch deletion
  if [ "$local_oid" = "$z40" ] || [ "$local_ref" = "(delete)" ]; then
    continue
  fi

  # Skip tag pushes
  if [[ "$remote_ref" == refs/tags/* ]]; then
    continue
  fi

  # Extract branch name from remote_ref or local_ref
  branch_name="${remote_ref#refs/heads/}"
  if [ "$branch_name" = "$remote_ref" ]; then
    branch_name="${local_ref#refs/heads/}"
  fi

  if ! [[ "$branch_name" =~ $PATTERN ]]; then
    echo ""
    echo "================================================================================"
    echo "❌ PUSH REJECTED: Invalid branch name '$branch_name'"
    echo "================================================================================"
    echo "Branch names must adhere to the project naming convention:"
    echo "  • feature/<ticket-number>-<description>  (e.g. feature/ME-42-user-auth)"
    echo "  • bugfix/<ticket-number>-<description>   (e.g. bugfix/ME-105-fix-dropdown)"
    echo "  • hotfix/<ticket-number>-<description>   (e.g. hotfix/ME-999-prod-patch)"
    echo "  • docs/<ticket-number>-<description>     (e.g. docs/ME-12-api-guide)"
    echo "  • refactor/<ticket-number>-<description> (e.g. refactor/ME-88-store-cleanup)"
    echo "  • main, dev"
    echo ""
    echo "Ticket number must be formatted as KEY-123 (e.g. ME-42) or digits (e.g. 42)."
    echo "Description must use lowercase alphanumeric characters and hyphens."
    echo "================================================================================"
    echo ""
    exit 1
  fi
done

exit 0
