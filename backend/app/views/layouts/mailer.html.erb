<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f5f7;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: #172b4d;
        line-height: 1.5;
      }
      .email-wrapper {
        width: 100%;
        background-color: #f4f5f7;
        padding: 30px 15px;
      }
      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 8px;
        border: 1px solid #ebecf0;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(9, 30, 66, 0.08);
      }
      .email-header {
        background-color: #0052cc;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .brand-title {
        color: #ffffff;
        font-size: 16px;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.2px;
      }
      .project-badge {
        background-color: rgba(255, 255, 255, 0.2);
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 4px;
        text-transform: uppercase;
      }
      .email-body {
        padding: 24px;
      }
      .actor-info {
        font-size: 14px;
        color: #5e6c84;
        margin-bottom: 16px;
      }
      .actor-name {
        font-weight: 600;
        color: #172b4d;
      }
      .issue-box {
        background-color: #f8f9fa;
        border: 1px solid #ebecf0;
        border-radius: 6px;
        padding: 16px;
        margin-bottom: 20px;
      }
      .issue-key {
        color: #0052cc;
        font-weight: 700;
        font-size: 13px;
        margin-bottom: 4px;
      }
      .issue-title {
        font-size: 17px;
        font-weight: 700;
        color: #172b4d;
        margin: 0 0 12px 0;
      }
      .meta-grid {
        display: table;
        width: 100%;
        margin-top: 8px;
      }
      .meta-row {
        display: table-row;
      }
      .meta-label {
        display: table-cell;
        font-size: 12px;
        font-weight: 600;
        color: #6b778c;
        padding: 4px 12px 4px 0;
        width: 90px;
      }
      .meta-val {
        display: table-cell;
        font-size: 12px;
        color: #172b4d;
        padding: 4px 0;
      }
      .pill {
        display: inline-block;
        padding: 2px 7px;
        font-size: 11px;
        font-weight: 600;
        border-radius: 3px;
        background-color: #ebecf0;
        color: #42526e;
      }
      .pill-primary {
        background-color: #deebff;
        color: #0747a6;
      }
      .content-box {
        background-color: #ffffff;
        border-left: 3px solid #0052cc;
        padding: 12px 16px;
        margin: 16px 0;
        font-size: 13px;
        color: #253858;
        border-radius: 0 4px 4px 0;
        background-color: #fbfbfb;
      }
      .btn-primary {
        display: inline-block;
        background-color: #0052cc;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 13px;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 4px;
        margin-top: 16px;
      }
      .email-footer {
        padding: 16px 24px;
        background-color: #fafbfc;
        border-top: 1px solid #ebecf0;
        font-size: 11px;
        color: #7a869a;
        line-height: 1.4;
      }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-container">
        <div class="email-header">
          <span class="brand-title">ManagEase</span>
          <% if @project.present? %>
            <span class="project-badge"><%= @project.key %></span>
          <% end %>
        </div>
        <div class="email-body">
          <%= yield %>
        </div>
        <div class="email-footer">
          This notification was sent by ManagEase. You received this email because you are assigned, reported, or participated in this issue.
        </div>
      </div>
    </div>
  </body>
</html>
