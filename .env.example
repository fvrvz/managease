# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=managease
POSTGRES_PASSWORD=managease_secret
POSTGRES_DB=managease_development
DATABASE_URL=postgresql://managease:managease_secret@db:5432/managease_development

# ─── Rails ───────────────────────────────────────────────────────────────────
RAILS_ENV=development
SECRET_KEY_BASE=change_me_in_production_use_rails_secret
RAILS_MASTER_KEY=

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── OIDC / OAuth2 (optional — leave blank to use local auth only) ────────────
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=https://accounts.google.com
OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
# For Google: https://accounts.google.com
# For Keycloak: http://keycloak:8080/realms/myrealm
# For Auth0: https://your-domain.auth0.com

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRY_HOURS=24

# ─── ActiveStorage / S3 (optional) ───────────────────────────────────────────
STORAGE_SERVICE=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET=managease-attachments

